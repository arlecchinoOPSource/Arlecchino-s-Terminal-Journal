{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main local window: journal operations, editor preferences and close notification only.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-journal-list",
    "allow-journal-last",
    "allow-journal-select",
    "allow-journal-save",
    "allow-journal-delete",
    "allow-journal-finish-exit",
    "allow-preferences-get",
    "allow-preferences-set",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
