{
  "name": "terminal-by-arlecchino",
  "version": "0.1.0",
  "private": true,
  "description": "Offline desktop journal — early writing preview",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-sql": "2.6.0",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/extension-text-align": "3.32.2",
    "@tiptap/extension-text-style": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "oxlint": "1.90.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tauri build --no-bundle",
    "build:web": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src tests vite.config.ts",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
