{
  "name": "terminal-by-arlecchino",
  "version": "2.0.0",
  "private": true,
  "description": "Offline desktop journal — early writing preview",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "5.3.0",
    "@fontsource/ibm-plex-serif": "5.3.0",
    "@fontsource/literata": "5.3.0",
    "@fontsource/orbitron": "5.3.0",
    "@tauri-apps/api": "2.12.4",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/extension-text-align": "3.32.2",
    "@tiptap/extension-text-style": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "oxlint": "1.90.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tauri build --no-bundle",
    "build:web": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src tests vite.config.ts playwright.config.ts",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "test:native": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --locked && python3 tests/sqlite_schema.py",
    "check": "npm run lint && npm run typecheck && npm test && npm run build:web && npm run test:ui && npm run test:native",
    "preview": "vite preview",
    "tauri": "tauri"
  }
}
