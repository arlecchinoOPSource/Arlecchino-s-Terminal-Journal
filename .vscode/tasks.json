{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Terminal: Run desktop preview",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "osx": { "options": { "env": { "DEVELOPER_DIR": "/Applications/Xcode.app/Contents/Developer" } } }
    },
    {
      "label": "Terminal: Check",
      "type": "shell",
      "command": "npm run lint && npm run typecheck && npm test",
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "Terminal: Native storage tests",
      "type": "shell",
      "command": "cargo test --manifest-path src-tauri/Cargo.toml",
      "problemMatcher": [],
      "osx": { "options": { "env": { "DEVELOPER_DIR": "/Applications/Xcode.app/Contents/Developer" } } }
    }
  ]
}
